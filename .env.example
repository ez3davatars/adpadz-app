# Frontend-safe Supabase project URL.
VITE_SUPABASE_URL=

# Frontend-safe Supabase anon/publishable key. Do not use a service-role key here.
VITE_SUPABASE_ANON_KEY=

# Deployed Adpadz domain used for generated QR short links.
VITE_PUBLIC_APP_URL=https://adpadz.co

# Do not commit real .env files. Do not add a Supabase service-role key to any VITE_ variable.
