RewriteEngine On

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# QR redirect route handled by PHP on Apache/cPanel hosting.
RewriteRule ^q/([A-Za-z0-9_-]+)/?$ qr-redirect.php?slug=$1 [L,QSA]

# Existing files and directories should be served directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# React/Vite SPA fallback for /app/* and other client routes.
RewriteRule ^ index.html [L]
